# Frontend: deixe vazio para usar /api/push no mesmo domínio.
# Em hospedagem estática, informe a URL HTTPS do servidor de push.
VITE_PUSH_API_URL=

# Backend: npm run push:keys gera .push-keys.json para desenvolvimento.
# Em produção use variáveis de ambiente, mantendo as mesmas chaves entre deploys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PORT=3001
# URL exata do frontend, sem barra final. Obrigatória para acesso entre domínios.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
